NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_. Used by admin account
# management (create/restrict/reset-password). Find it in Supabase Dashboard
# -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only — powers the AI chat widget (web/app/api/chat). Get a key at
# https://aistudio.google.com/apikey. Never prefix with NEXT_PUBLIC_ — the
# mobile app reaches this through the API route below, not this key directly.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
