EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the web app, used to reach the AI chat proxy (web/app/api/chat).
# The Gemini key itself lives only in web/.env.local (server-only) — the
# mobile app never holds it directly. Point this at wherever that server is
# reachable from your phone/simulator, e.g. your machine's LAN IP in dev.
EXPO_PUBLIC_API_URL=http://localhost:3000
